{name:"삼색설기",category:"떡",feature:"서로 다른 색의 설기를 층층이 쌓아 만든다.",method:"쌀가루를 여러 색으로 나눈 뒤 층층이 담아 찜기에 넣어 찐다."},
{name:"약식단자",category:"떡",feature:"약식의 재료와 단자의 형태를 결합한 전통 떡이다.",method:"찹쌀과 대추, 밤 등을 익혀 반죽한 뒤 작게 빚어 고물을 묻힌다."},
{name:"과편",category:"한과",feature:"과일의 색과 향을 살려 굳혀 만드는 전통 후식이다.",method:"과일즙을 끓인 뒤 녹말이나 한천 등을 넣어 굳히고 먹기 좋은 크기로 자른다."},
{name:"살구편",category:"한과",feature:"살구의 새콤달콤한 맛과 향을 살린 과편이다.",method:"살구를 익혀 즙이나 과육을 만든 뒤 설탕과 함께 끓이고 굳힌다."},
{name:"앵두편",category:"한과",feature:"앵두의 붉은색과 새콤한 맛이 특징이다.",method:"앵두를 으깨 즙을 낸 뒤 설탕과 함께 끓여 굳힌다."},
{name:"모과편",category:"한과",feature:"모과의 향긋한 향과 달콤한 맛이 특징이다.",method:"모과를 삶아 으깬 뒤 설탕과 함께 끓이고 굳혀 만든다."},
{name:"국화전",category:"전통 후식",feature:"국화꽃을 올려 아름답게 장식하는 전통 음식이다.",method:"찹쌀가루 반죽을 얇게 펴서 기름에 지지고 식용 국화꽃을 올린다."},
{name:"매화전",category:"전통 후식",feature:"매화꽃 모양으로 장식해 봄의 분위기를 나타내는 음식이다.",method:"찹쌀가루 반죽을 작게 빚어 지진 뒤 매화 모양의 꽃을 올린다."},
{name:"진달래화전",category:"전통 후식",feature:"진달래꽃을 올려 분홍빛이 아름다운 화전이다.",method:"찹쌀가루 반죽을 얇게 만들어 지지고 식용 진달래꽃을 올린다."},
{name:"장미화전",category:"전통 후식",feature:"장미꽃을 이용해 아름답게 장식한 화전이다.",method:"찹쌀 반죽을 작게 펴서 지진 뒤 식용 장미꽃잎을 올린다."},
{name:"수수전",category:"전통 후식",feature:"수수가루를 이용해 고소한 맛을 내는 전이다.",method:"수수가루에 물을 넣어 반죽하고 얇게 펴서 기름에 지진다."},
{name:"빈대떡",category:"전통 음식",feature:"녹두를 갈아 만드는 고소한 전으로 간식처럼 먹기도 한다.",method:"불린 녹두를 갈아 반죽하고 채소 등을 넣어 기름에 노릇하게 부친다."},
{name:"녹두전",category:"전통 음식",feature:"녹두의 고소한 맛과 바삭한 겉면이 특징이다.",method:"불린 녹두를 갈아 반죽한 뒤 재료를 넣고 기름에 부친다."},
{name:"메밀전병",category:"전통 음식",feature:"메밀로 얇은 전을 만들고 속재료를 넣어 말아 먹는다.",method:"메밀가루로 묽은 반죽을 만들어 얇게 부친 뒤 속재료를 넣고 돌돌 만다."},
{name:"찰수수부꾸미",category:"떡",feature:"찰수수의 쫀득함과 팥소의 달콤함이 특징이다.",method:"찰수수가루로 반죽을 만들어 팥소를 넣고 납작하게 빚은 뒤 기름에 지진다."},
{name:"오미자편",category:"한과",feature:"오미자의 붉은색과 새콤달콤한 맛이 특징이다.",method:"오미자를 우려낸 물에 설탕과 녹말 등을 넣고 끓인 뒤 굳혀서 자른다."},
{name:"배편",category:"한과",feature:"배의 달콤하고 은은한 향을 이용해 만든 전통 후식이다.",method:"배를 갈아 즙을 낸 뒤 설탕과 함께 끓이고 굳혀 먹기 좋은 크기로 자른다."},
{name:"호두정과",category:"정과",feature:"호두의 고소함과 꿀 또는 조청의 달콤함이 어우러진다.",method:"호두를 손질해 꿀이나 조청에 넣고 약한 불에서 졸인다."},
{name:"인삼정과",category:"정과",feature:"인삼을 달콤하게 졸여 인삼 특유의 향을 살린다.",method:"인삼을 깨끗하게 손질해 삶은 뒤 꿀이나 조청에 넣어 천천히 졸인다."},
{name:"도라지강정",category:"한과",feature:"도라지를 튀겨 조청을 입혀 바삭하고 달콤하게 만든다.",method:"도라지를 손질해 튀긴 뒤 조청을 묻혀 굳힌다."},
{name:"연근강정",category:"한과",feature:"연근의 바삭한 식감과 달콤한 조청 맛이 특징이다.",method:"연근을 얇게 썰어 튀긴 뒤 조청에 버무린다."},
{name:"대추강정",category:"한과",feature:"대추의 달콤함과 견과류의 고소함을 함께 즐길 수 있다.",method:"대추를 손질하고 견과류와 함께 조청에 버무려 굳힌다."},
{name:"깨엿",category:"엿",feature:"엿의 달콤함과 깨의 고소함이 어우러진 전통 간식이다.",method:"엿을 녹여 볶은 깨를 섞은 뒤 굳혀 먹기 좋은 크기로 자른다."},
{name:"콩엿",category:"엿",feature:"볶은 콩과 엿을 함께 만들어 고소하고 달콤하다.",method:"볶은 콩에 녹인 엿을 섞고 틀에 넣어 굳힌다."},
{name:"호박엿",category:"엿",feature:"호박을 이용해 달콤한 맛과 은은한 호박 향을 내는 엿이다.",method:"호박을 익혀 즙을 낸 뒤 엿기름과 함께 달여 엿을 만든다."},
{name:"쌀엿",category:"엿",feature:"쌀을 기본 재료로 만들어 달콤하고 쫀득한 식감이 특징이다.",method:"쌀로 밥을 지은 뒤 엿기름을 이용해 당화시키고 오랫동안 졸여 엿을 만든다."},
{name:"오메기떡",category:"떡",feature:"제주도 좁쌀로 만들어 쫀득하고 구수한 맛이 나는 향토떡이다.",method:"좁쌀가루를 반죽해 쪄서 치댄 뒤 팥고물을 묻힌다."},
{name:"빙떡",category:"떡",feature:"메밀가루 전병에 무나물을 말아 넣은 제주 향토 떡이다.",method:"메밀가루 반죽을 얇게 부쳐 채 썬 무나물을 넣고 돌돌 만다."},
{name:"노티",category:"떡",feature:"차조와 기장 등으로 만들어 쉽게 상하지 않는 북부 지방 향토 떡이다.",method:"차조 반죽을 지진 뒤 엿기름물에 삭혀 노릇하게 다시 지진다."},
{name:"수수경단",category:"떡",feature:"수수가루로 빚어 붉은빛이 돌며 액막이 음식으로도 쓰였다.",method:"수수가루 반죽을 동그랗게 빚어 삶은 뒤 고물을 묻힌다."},
{name:"원소병",category:"전통음료·후식",feature:"찹쌀 경단을 꿀물에 띄워 먹는 궁중 후식이다.",method:"오색 찹쌀 경단을 빚어 삶은 뒤 꿀물이나 오미자물에 띄운다."},
{name:"떡수단",category:"전통음료",feature:"가래떡을 잘라 꿀물에 띄운 여름철 시원한 후식이다.",method:"가래떡을 작게 썰어 데친 뒤 꿀물이나 오미자물에 띄운다."},
{name:"밤초",category:"한과",feature:"밤을 통째로 졸여 만들어 달콤하고 형태가 그대로 살아 있다.",method:"밤을 삶아 속껍질을 벗긴 뒤 꿀이나 설탕물에 졸인다."},
{name:"대추초",category:"한과",feature:"대추를 통째로 졸여 만들어 쫀득하고 달콤하다.",method:"대추씨를 뺀 뒤 꿀에 넣고 졸여 잣을 박아 마무리한다."},
{name:"율란",category:"한과",feature:"삶은 밤을 으깨 다시 밤 모양으로 빚어 만드는 궁중 과자이다.",method:"삶은 밤을 곱게 으깨 꿀과 계핏가루를 섞어 밤 모양으로 빚는다."},
{name:"조란",category:"한과",feature:"대추를 으깨 다시 대추 모양으로 빚어 만드는 궁중 과자이다.",method:"대추를 삶아 씨를 빼고 곱게 다진 뒤 꿀과 섞어 대추 모양으로 빚는다."},
{name:"생란",category:"한과",feature:"생강즙을 넣어 알싸한 향이 나는 궁중 과자이다.",method:"마 반죽에 생강즙과 꿀을 섞어 빚어낸다."},
{name:"은행알쌈",category:"한과",feature:"은행을 대추 과육으로 감싸 만든 작고 귀여운 과자이다.",method:"볶은 은행을 얇게 편 대추 과육으로 돌돌 감싸 마무리한다."},
{name:"잣박산",category:"한과",feature:"잣을 엿에 버무려 얇게 굳힌 고소한 과자이다.",method:"잣을 녹인 엿과 버무려 얇게 편 뒤 굳혀서 자른다."},
{name:"깨엿강정",category:"한과",feature:"깨와 엿을 함께 굳혀 고소하고 진한 단맛이 난다.",method:"볶은 깨를 녹인 엿과 섞어 판에 펴 굳힌 뒤 자른다."},
{name:"편강",category:"정과",feature:"생강을 얇게 저며 설탕에 조려 말린 알싸한 간식이다.",method:"생강을 얇게 썰어 데친 뒤 설탕에 조리고 말려 마무리한다."},
{name:"은행정과",category:"정과",feature:"은행을 꿀이나 설탕에 졸여 만든 고소한 간식이다.",method:"볶은 은행을 꿀이나 설탕물에 졸여 만든다."},
{name:"배정과",category:"정과",feature:"배를 조려 만들어 은은한 단맛과 향이 난다.",method:"배를 저며 꿀이나 설탕물에 서서히 졸인다."},
{name:"감떡",category:"떡",feature:"곶감이나 감을 넣어 달콤한 맛을 내는 떡이다.",method:"감을 잘게 썰거나 으깨 쌀가루와 섞어 쪄낸다."},
{name:"호박고지떡",category:"떡",feature:"말린 호박고지를 넣어 쫄깃하고 달콤한 맛이 난다.",method:"말린 호박고지를 불려 쌀가루와 섞어 찜기에 쪄낸다."},
{name:"무시루떡",category:"떡",feature:"무를 채 썰어 넣어 시원하고 담백한 맛이 난다.",method:"채 썬 무와 쌀가루를 켜켜이 놓고 시루에 쪄낸다."},
{name:"감자떡",category:"떡",feature:"감자녹말을 이용해 쫀득한 식감을 내는 강원도 향토떡이다.",method:"감자녹말 반죽에 소를 넣고 빚어 삶거나 쪄낸다."},
{name:"콩설기",category:"떡",feature:"콩을 섞어 고소한 맛을 더한 설기이다.",method:"불린 콩을 멥쌀가루에 섞어 찜기에 쪄낸다."},
{name:"밤설기",category:"떡",feature:"밤을 넣어 달콤하고 포슬한 맛을 내는 설기이다.",method:"삶은 밤을 쌀가루와 섞어 찜기에 쪄낸다."},
{name:"잣설기",category:"떡",feature:"잣을 올려 고소한 향을 더한 설기이다.",method:"멥쌀가루에 잣을 올려 찜기에 쪄낸다."},
{name:"쑥인절미",category:"떡",feature:"쑥을 넣어 향긋하고 초록빛이 도는 인절미이다.",method:"쑥을 섞은 찹쌀을 쪄서 치댄 뒤 콩고물을 묻힌다."},
{name:"흑임자인절미",category:"떡",feature:"검은깨 고물을 묻혀 고소하고 짙은 색을 내는 인절미이다.",method:"찹쌀을 쪄서 치댄 뒤 흑임자 고물을 묻힌다."}
];

const SPOTS = [
  {name:"낙원떡집 (서울 낙원동)", addr:"100년 넘게 이어온 떡집, 두텁떡·오색경단으로 유명"},
  {name:"경기떡집 (서울 망원동)", addr:"30년 넘게 자리를 지킨 이북식 인절미 명가"},
  {name:"거북이한과 (제주 서귀포)", addr:"얇은 반죽을 겹겹이 쌓아 튀긴 약과로 유명"},
  {name:"버들골 약과 (강원 춘천)", addr:"3대째 이어온 페스츄리 식감의 약과"},
  {name:"궁중본영의정인절미떡집 (경기 파주)", addr:"2대째 이어가는 전통 인절미 전문점"}
];

const CAT_COLORS = {
  "한과":"var(--dahong)","정과":"var(--song)","떡":"var(--cheong)","엿":"var(--yuja)",
  "전통음료":"var(--cheong)","전통음료·후식":"var(--cheong)","전통 후식":"var(--yuja)","전통 음식":"var(--dahong)"
};

const main = document.getElementById('dictList');
const catNav = document.getElementById('catNav');
const countBadge = document.getElementById('countBadge');
const countLine = document.getElementById('countLine');
const searchInput = document.getElementById('search');
const overlay = document.getElementById('overlay');
const dropCard = document.getElementById('dropCard');
const spotList = document.getElementById('spotList');

let activeCat = null;

function renderSpots(){
  spotList.innerHTML = SPOTS.map(s=>`<div class="spot-item"><span class="sname">${s.name}</span><span class="saddr">${s.addr}</span></div>`).join('');
}

function closeCard(){
  dropCard.classList.remove('show');
  overlay.classList.remove('show');
}

function openCard(item){
  const color = CAT_COLORS[item.category] || 'var(--dahong)';
  dropCard.style.borderColor = color;
  let extra = '';
  if(item.art){ extra += `<div class="block">${item.art}</div>`; }
  if(item.history){ extra += `<div class="block"><div class="field-label" style="color:${color}">유래</div><div class="field-value">${item.history}</div></div>`; }
  if(item.pair){ extra += `<div class="block"><div class="field-label" style="color:${color}">같이 먹으면 좋은 것</div><div class="field-value">${item.pair}</div></div>`; }
  dropCard.innerHTML = `
    <div class="dc-head">
      <div><h3>${item.name}</h3><div class="dc-cat">${item.category}</div></div>
      <button class="close-x" type="button" id="dcClose">닫기</button>
    </div>
    <div class="block"><div class="field-label" style="color:${color}">만드는 법</div><div class="field-value">${item.method}</div></div>
    <div class="block"><div class="field-label" style="color:${color}">재료·맛의 특징</div><div class="field-value">${item.feature}</div></div>
    ${extra}
  `;
  overlay.classList.add('show');
  requestAnimationFrame(()=> dropCard.classList.add('show'));
  document.getElementById('dcClose').addEventListener('click', closeCard);
}

overlay.addEventListener('click', closeCard);
document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') closeCard(); });

function koSort(a,b){ return a.name.localeCompare(b.name,'ko'); }

function render(){
  const q = searchInput.value.trim();
  let list = [...DATA];
  if(activeCat) list = list.filter(it=>it.category===activeCat);
  if(q) list = list.filter(it=>it.name.includes(q)||it.category.includes(q));
  list.sort(koSort);

  countBadge.innerHTML = `<b>${list.length}</b> / ${DATA.length}가지`;
  countLine.textContent = activeCat ? `“${activeCat}” 분류` : '전체 가나다순';

  if(list.length===0){
    main.innerHTML = `<div class="empty-msg">‘${q}’와 어울리는 간식을 찾지 못했습니다.</div>`;
    return;
  }

  main.innerHTML = list.map((item,i)=>{
    const color = CAT_COLORS[item.category] || 'var(--dahong)';
    return `<button type="button" class="entry" style="--cat-color:${color}" data-name="${item.name}">
      <span class="left">
        <span class="idx">${String(i+1).padStart(2,'0')}</span>
        <span class="name">${item.name}</span>
        <span class="feat">${item.feature}</span>
      </span>
      <span class="cat">${item.category}</span>
    </button>`;
  }).join('');

  main.querySelectorAll('.entry').forEach(el=>{
    el.addEventListener('click', ()=>{
      const item = DATA.find(d=>d.name===el.dataset.name);
      openCard(item);
    });
  });
}

function buildNav(){
  const cats = [...new Set(DATA.map(d=>d.category))];
  catNav.innerHTML = '<button type="button" data-cat="" class="active">전체</button>' +
    cats.map(c=>`<button type="button" data-cat="${c}">${c}</button>`).join('');
  catNav.querySelectorAll('button').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      activeCat = btn.dataset.cat || null;
      catNav.querySelectorAll('button').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      render();
    });
  });
}

searchInput.addEventListener('input', render);

renderSpots();
buildNav();
render();
</script>
</body>
</html>
